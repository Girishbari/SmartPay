# Copy to .env (git-ignored). Any running Postgres works; the Engine keeps its tables in its own schema, "billing_engine".
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Optional. RECORDER=tab records in your own browser tab (what Render uses); default "window" opens the Engine's recorder window.
# RECORDER=tab
# HOST=0.0.0.0            # Render needs this; locally the Engine stays on 127.0.0.1
# DEMO_APP_URL=http://127.0.0.1:4000   # use the standalone demo app (pnpm dev:demo) instead of the Engine's /demo/
